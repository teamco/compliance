# Root .env — loaded by every service (gateway + each microservice) AFTER
# its own service-specific .env, so vars here are shared across all of them.
# Copy to .env and fill in.

# HMAC secret signing every gateway → microservice RPC call (@idevconn/nestjs-resilience).
# Must be IDENTICAL across the gateway and every microservice, or signature
# verification fails. Unset in dev = calls go unsigned (HmacGuard passes them
# through); unset in NODE_ENV=production = both signing and verification
# refuse to proceed. Generate with: openssl rand -hex 32
MS_HMAC_SECRET=
