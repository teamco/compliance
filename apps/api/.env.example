API_ORIGIN=http://localhost
API_PORT=3001

# NODE_ENV controls cookie security flags (Secure/SameSite) for the httpOnly
# auth cookies — MUST be set to `production` in any real deployment, or
# refresh/CSRF cookies ship without Secure/SameSite=None and CORS credentials
# will be rejected by browsers in a cross-origin production setup.
NODE_ENV=development

# Origin of the SPA client — used for CORS (credentials:true) and all auth
# redirect URLs (magic-link, OAuth callback). Must exactly match the client's
# real origin (scheme+host+port) in every environment.
CLIENT_ORIGIN=http://localhost:4200

# Auth MS transport — must match apps/microservices/auth/.env
AUTH_TRANSPORT=tcp
AUTH_HOST=127.0.0.1
AUTH_PORT=4001
# AUTH_REDIS_URL=redis://localhost:6379
# AUTH_NATS_URL=nats://localhost:4222
# AUTH_MQTT_URL=mqtt://localhost:1883
# AUTH_RMQ_URL=amqp://localhost:5672
# AUTH_RMQ_QUEUE=auth_queue
# AUTH_KAFKA_BROKERS=localhost:9092
# AUTH_KAFKA_CLIENT_ID=auth

# Upload MS transport — must match apps/microservices/upload/.env
UPLOAD_TRANSPORT=tcp
UPLOAD_HOST=127.0.0.1
UPLOAD_PORT=4002
# UPLOAD_REDIS_URL=redis://localhost:6379
# UPLOAD_NATS_URL=nats://localhost:4222
# UPLOAD_MQTT_URL=mqtt://localhost:1883
# UPLOAD_RMQ_URL=amqp://localhost:5672
# UPLOAD_RMQ_QUEUE=upload_queue
# UPLOAD_KAFKA_BROKERS=localhost:9092
# UPLOAD_KAFKA_CLIENT_ID=upload

# Notes MS transport — must match apps/microservices/notes/.env
NOTES_TRANSPORT=tcp
NOTES_HOST=127.0.0.1
NOTES_PORT=4004
# NOTES_REDIS_URL=redis://localhost:6379
# NOTES_NATS_URL=nats://localhost:4222
# NOTES_MQTT_URL=mqtt://localhost:1883
# NOTES_RMQ_URL=amqp://localhost:5672
# NOTES_RMQ_QUEUE=notes_queue
# NOTES_KAFKA_BROKERS=localhost:9092
# NOTES_KAFKA_CLIENT_ID=notes

# Payment MS transport — must match apps/microservices/payment/.env
PAYMENT_TRANSPORT=tcp
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=4003
# PAYMENT_REDIS_URL=redis://localhost:6379
# PAYMENT_NATS_URL=nats://localhost:4222
# PAYMENT_MQTT_URL=mqtt://localhost:1883
# PAYMENT_RMQ_URL=amqp://localhost:5672
# PAYMENT_RMQ_QUEUE=payment_queue
# PAYMENT_KAFKA_BROKERS=localhost:9092
# PAYMENT_KAFKA_CLIENT_ID=payment

# AI MS transport — must match apps/microservices/ai/.env
AI_TRANSPORT=tcp
AI_HOST=127.0.0.1
AI_PORT=4005
# AI_REDIS_URL=redis://localhost:6379
# AI_NATS_URL=nats://localhost:4222
# AI_MQTT_URL=mqtt://localhost:1883
# AI_RMQ_URL=amqp://localhost:5672
# AI_RMQ_QUEUE=ai_queue
# AI_KAFKA_BROKERS=localhost:9092
# AI_KAFKA_CLIENT_ID=ai

# Vendor Risk MS transport — must match apps/microservices/vendor-risk/.env
VENDOR_RISK_TRANSPORT=tcp
VENDOR_RISK_HOST=127.0.0.1
VENDOR_RISK_PORT=4006
# VENDOR_RISK_REDIS_URL=redis://localhost:6379
# VENDOR_RISK_NATS_URL=nats://localhost:4222
# VENDOR_RISK_MQTT_URL=mqtt://localhost:1883
# VENDOR_RISK_RMQ_URL=amqp://localhost:5672
# VENDOR_RISK_RMQ_QUEUE=vendor_risk_queue
# VENDOR_RISK_KAFKA_BROKERS=localhost:9092
# VENDOR_RISK_KAFKA_CLIENT_ID=vendor_risk

# Per-request multipart file size cap (KB). Default 5120 (5 MB) when unset.
MAX_FILE_SIZE_KB=5120

# --- pg-boss queue: PostgreSQL connection ---
# Direct connection (Linux/IPv6-capable hosts):
#   postgresql://postgres:[YOUR-PASSWORD]@db.yfnzcydahthhrdxnqjpk.supabase.co:5432/postgres
# Session pooler (Windows / IPv4-only / no direct host access).
# NOTE region prefix is aws-1 (not aws-0) for this project — verify exact host
# in Supabase Dashboard → Database → Connection string → Session pooler.
DATABASE_URL=postgresql://postgres.yfnzcydahthhrdxnqjpk:[YOUR-PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

